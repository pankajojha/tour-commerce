erDiagram
    DESTINATION ||--o{ EXCURSION : contains
    EXCURSION ||--o{ EXCURSION_SCHEDULE : has
    SUPPLIER ||--o{ EXCURSION : provides
    DESTINATION ||--o{ CRUISEPORTCALL : contains
    DESTINATION ||--o{ FLIGHTARRIVAL : contains
    EXCURSION ||--o{ BOOKING : booked_in

    DESTINATION {
        int id
        string name
        string country
        string port_code
        string airport_code
        string timezone
        string geo_coordinates
    }
    EXCURSION {
        int id
        string title
        string description
        int destination_id
        int duration_minutes
        string difficulty_level
        string meeting_point
        string cancellation_policy
        int supplier_id
        float base_price
        string currency
        bool active_status
    }
    EXCURSION_SCHEDULE {
        int id
        int excursion_id
        datetime start_time
        datetime end_time
        int capacity
        int available_spots
        string operating_days
        date[] blackout_dates
    }
    SUPPLIER {
        int id
        string company_name
        string contact_email
        string contract_type
        float commission_percentage
    }
    CRUISEPORTCALL {
        int id
        string cruise_line
        string ship_name
        string sailing_id
        int destination_id
        datetime arrival_time
        datetime departure_time
        date date
    }
    FLIGHTARRIVAL {
        int id
        string airline
        string flight_number
        string arrival_airport
        datetime arrival_time
        date date
    }